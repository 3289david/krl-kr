# ─── Database (PostgreSQL on VPS) ─────────────────────────────────────────────
DATABASE_URL=postgresql://krlkr:YOUR_DB_PASSWORD@localhost:5432/krlkr
DATABASE_SSL=false

# ─── Cache (Redis on VPS) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Application ──────────────────────────────────────────────────────────────
APP_URL=https://krl.kr
SHORT_DOMAIN=krl.kr
NODE_ENV=production
JWT_SECRET=your-64-char-hex-secret-here

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/var/www/krl-kr/uploads
MAX_FILE_SIZE_MB=100

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@krl.kr

# ─── Cloudflare (ONLY for DNS + Email Routing API) ────────────────────────────
# Required only if using subdomain service or email alias feature
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id

# ─── Cloudflare Email Worker ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Also set on the Worker: wrangler secret put WORKER_SECRET --config wrangler.email.toml
WORKER_SECRET=your-64-char-hex-secret-here

# ─── Optional: Rate limiting ──────────────────────────────────────────────────
# RATE_LIMIT_ANON_PER_HOUR=20
# RATE_LIMIT_AUTH_PER_HOUR=1000
