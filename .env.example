# ─── Database (PostgreSQL on VPS) ─────────────────────────────────────────────
DATABASE_URL=
DATABASE_SSL=

# ─── Cache (Redis on VPS) ─────────────────────────────────────────────────────
REDIS_URL=

# ─── Application ──────────────────────────────────────────────────────────────
APP_URL=
SHORT_DOMAIN=
NODE_ENV=
JWT_SECRET=

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=
MAX_FILE_SIZE_MB=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Cloudflare (ONLY for DNS + Email Routing API) ────────────────────────────
# Required only if using subdomain service or email alias feature
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

# ─── Optional: Rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_ANON_PER_HOUR=
RATE_LIMIT_AUTH_PER_HOUR=

WORKER_SECRET=

BMC_WEBHOOK_SECRET=
CRON_SECRET=
OPENAI_API_KEY=

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
