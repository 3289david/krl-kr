# ─── Database (PostgreSQL on VPS) ─────────────────────────────────────────────
DATABASE_URL=postgresql://krlkr:YOUR_DB_PASSWORD@localhost:5432/krlkr
DATABASE_SSL=false

# ─── Cache (Redis on VPS) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Application ──────────────────────────────────────────────────────────────
APP_URL=https://krl.kr
SHORT_DOMAIN=krl.kr
NODE_ENV=production
JWT_SECRET=your-64-char-hex-secret-here

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=/var/www/krl-kr/uploads
MAX_FILE_SIZE_MB=100

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@krl.kr

# ─── Cloudflare (DNS + Email Routing API) ─────────────────────────────────────
# 서브도메인 서비스 또는 이메일 별칭 기능 사용 시 필요
# Cloudflare 대시보드 → API Tokens → Create Token
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id

# ─── Cloudflare Workers 공유 시크릿 ──────────────────────────────────────────
# VPS ↔ Edge Worker / Email Worker / Cache Worker 인증에 사용
# 생성: openssl rand -hex 32
#
# 각 워커에도 동일하게 설정:
#   wrangler secret put WORKER_SECRET                          (edge worker)
#   wrangler secret put WORKER_SECRET --config wrangler.email.toml
#   wrangler secret put WORKER_SECRET --config wrangler.cache.toml
WORKER_SECRET=your-64-char-hex-secret-here

# ─── Cloudflare Cache Worker URL ─────────────────────────────────────────────
# 캐시 무효화에 사용. 워커 배포 후 자동으로 생성되는 URL
# 형식: https://krl-kr-cache.YOUR_SUBDOMAIN.workers.dev
# (예: https://krl-kr-cache.rukkit.workers.dev)
CACHE_WORKER_URL=https://krl-kr-cache.rukkit.workers.dev

# ─── Optional: Rate limiting ──────────────────────────────────────────────────
# RATE_LIMIT_ANON_PER_HOUR=20
# RATE_LIMIT_AUTH_PER_HOUR=1000
