{
  "name": "krl-kr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && grep -q HOSTNAME .next/standalone/.env 2>/dev/null || echo \"HOSTNAME=127.0.0.1\" >> .next/standalone/.env",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "psql $DATABASE_URL -f migrations/0001_init_postgres.sql",
    "worker:dev": "wrangler dev worker/index.ts --env development",
    "worker:deploy": "wrangler deploy worker/index.ts",
    "email:deploy": "wrangler deploy --config wrangler.email.toml",
    "email:secret": "wrangler secret put WORKER_SECRET --config wrangler.email.toml"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "altcha": "^3.0.10",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "geist": "^1.3.1",
    "ioredis": "^5.10.1",
    "jose": "^5.10.0",
    "multer": "^2.1.1",
    "nanoid": "^5.1.5",
    "next": "15.3.2",
    "nodemailer": "^8.0.8",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.0",
    "ua-parser-js": "^2.0.3",
    "zod": "^3.25.48"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.10",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "postcss": "^8",
    "tailwindcss": "^4.1.7",
    "typescript": "^5",
    "wrangler": "^4.16.0"
  },
  "engines": {
    "node": ">=18"
  }
}
